<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    <IfModule mod_headers.c>
        Header always set Access-Control-Allow-Origin "https://www.blackwolvesacquisitionllc.com" "expr=%{REQUEST_URI} =~ m#^/api/#"
        Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" "expr=%{REQUEST_URI} =~ m#^/api/#"
        Header always set Access-Control-Allow-Headers "Authorization, Content-Type, X-Requested-With, Accept, Origin" "expr=%{REQUEST_URI} =~ m#^/api/#"
        Header always set Access-Control-Max-Age "86400" "expr=%{REQUEST_URI} =~ m#^/api/#"
    </IfModule>

    RewriteEngine On

    # Answer API preflight requests before Laravel routing.
    RewriteCond %{REQUEST_METHOD} OPTIONS [NC]
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ - [R=204,L]

    # Pass Authorization header to Laravel.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Never redirect API requests; route them straight to Laravel.
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ index.php [L]

    # Redirect non-www page traffic to the canonical www host.
    RewriteCond %{HTTP_HOST} ^blackwolvesacquisitionllc\.com$ [NC]
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteRule ^ https://www.blackwolvesacquisitionllc.com%{REQUEST_URI} [L,R=301]

    # Redirect trailing slashes if not a folder.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send all other requests to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
